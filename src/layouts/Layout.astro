---
import { getIdioma } from "../utils/i18n";

const lang = getIdioma();
const title = "Heaven's Door | Carta";
const description = "Carta digital de Heaven's Door Cerveceria.";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11100d" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="fondo flex min-h-dvh flex-col antialiased">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100dvh;
  }
</style>
