---
import type { IProducto } from "../interfaces/Producto";
import { getIdioma, traducir } from "../utils/i18n";

const producto = Astro.props as IProducto;
const precio = producto.precio.toLocaleString(getIdioma() === "en" ? "en-GB" : "es-ES", {
  minimumFractionDigits: Number.isInteger(producto.precio) ? 0 : 2,
  maximumFractionDigits: 2,
});
---

<article class="product-row">
  <div class="flex flex-row items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-lg font-semibold leading-snug text-stone-50">{traducir(producto.nombre)}</h3>
      {producto.nuevo && (
        <span class="mt-1 inline-flex rounded-full bg-amber-300 px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-zinc-950">
          {traducir("NUEVO")}
        </span>
      )}
    </div>
    <span class="shrink-0 text-right text-lg font-bold tabular-nums text-amber-100">{precio} &euro;</span>
  </div>
  {
    producto.descripcion && (
      <p class="mt-1.5 text-sm leading-relaxed text-stone-300">{traducir(producto.descripcion)}</p>
    )
  }
</article>
