---
import type {ICategoria} from "../interfaces/Categoria";
import {getIdioma, traducir} from "../utils/i18n";

const { categoria } = Astro.props as {
    categoria: ICategoria;
};
---

<a href={`/${getIdioma()}/productos#${categoria.nombre}`} class="category-card group">
    <span class="category-icon">
        <img
            src={`/images/categories/${categoria.imagen}`}
            alt=""
            width="56"
            height="56"
            decoding="async"
            class="h-11 w-11 object-contain"
        />
    </span>
    <span class="min-w-0 flex-1">
        <span class="block text-left text-lg font-bold leading-tight text-stone-50 xs:text-xl">
            {traducir(categoria.nombre)}
        </span>
        <span class="mt-1 block text-xs font-semibold uppercase tracking-[0.16em] text-amber-200/80">
            {traducir("VER_PRODUCTOS")}
        </span>
    </span>
</a>
