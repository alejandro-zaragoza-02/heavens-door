---
import type { ICategoria } from "../interfaces/Categoria";
import Producto from "./Producto.astro";
import {traducir} from "../utils/i18n";

const { categoria } = Astro.props as {
  categoria: ICategoria;
};
---

<section class="menu-section">
  <div class="category-heading mb-4 flex flex-row items-center gap-4" id={categoria.nombre}>
    <span class="category-icon">
      <img
        src={`/images/categories/${categoria.imagen}`}
        alt=""
        width="56"
        height="56"
        loading="lazy"
        decoding="async"
        class="h-11 w-11 object-contain"
      />
    </span>
    <div>
      <h2 class="text-2xl font-bold leading-tight text-amber-100">
        {traducir(categoria.nombre)}
      </h2>
      {categoria.descripcion && (
        <p class="mt-1 text-sm font-medium text-stone-300">{traducir(categoria.descripcion)}</p>
      )}
    </div>
  </div>
  <div class="product-list">
    {categoria.productos.map((producto) => <Producto {...producto} />)}
  </div>
</section>
